<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.griddigit.CimPal</groupId>
        <artifactId>CimPal</artifactId>
        <version>2026.9.10.1</version>
    </parent>

    <artifactId>CimPal-Main</artifactId>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.powsybl</groupId>
                <artifactId>powsybl-dependencies</artifactId>
                <version>${powsybl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <finalName>CimPal</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${jdk.version}</release>
                    <fork>true</fork>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <shadedArtifactAttached>false</shadedArtifactAttached>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>eu.griddigit.cimpal.main.application.CimPal</mainClass>
                            <manifestEntries>
                                <Multi-Release>true</Multi-Release>
                                <!-- JavaFX loads its native libraries through System::load, a
                                     restricted method. Since JDK 24 that prints a four-line
                                     warning on every start unless native access is granted, and
                                     a future release will block the call outright. The shaded
                                     jar strips module-info, so everything runs in the unnamed
                                     module: ALL-UNNAMED is the grant that applies. Honoured by
                                     `java -jar CimPal.jar`; the .exe gets the same grant as a
                                     JVM option below, since the wrapper does not read this. -->
                                <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                            </manifestEntries>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                            <addHeader>false</addHeader>
                        </transformer>
                        <!-- Merging substrate JSON configuration files -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-aarch64-darwin.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-arm64-ios.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-x86_64-darwin.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-x86_64-ios.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-aarch64-darwin.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-x86_64-darwin.json</resource>
                        </transformer>

                        <!-- Merging substrate configuration for Linux -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-x86_64-linux.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-x86_64-linux.json</resource>
                        </transformer>

                        <!-- Merging substrate configuration for Android and iOS -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-aarch64-android.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-arm64-ios.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig-x86_64-ios.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/jniconfig-aarch64-android.json</resource>
                        </transformer>

                        <!-- Merging additional conflicting resources -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/resourcebundles</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/substrate/config/reflectionconfig.json</resource>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                            <resource>META-INF/DEPENDENCIES</resource>
                        </transformer>
                    </transformers>

                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>module-info.class</exclude>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>META-INF/MANIFEST.MF</exclude>
                                <exclude>META-INF/versions/*/module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>

                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <version>${launch4j.version}</version>
                <executions>
                    <execution>
                        <id>l4j-clui</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <dontWrapJar>false</dontWrapJar>
                            <headerType>gui</headerType>
                            <jar>${project.build.directory}/${project.build.finalName}.jar</jar>
                            <outfile>${project.build.directory}/${project.build.finalName}.exe</outfile>
                            <errTitle>No Java installed.</errTitle>
                            <cmdLine/>
                            <chdir>.</chdir>
                            <priority>normal</priority>
                            <downloadUrl>https://github.com/griddigit-ci/CimPal/releases</downloadUrl>
                            <supportUrl>https://github.com/griddigit-ci/CimPal/wiki</supportUrl>
                            <stayAlive>false</stayAlive>
                            <restartOnCrash>false</restartOnCrash>
                            <manifest/>
                            <icon>src/main/resources/graphics/cimpal-icon-medium.ico</icon>
                            <jre>
                                <path>%JAVA_HOME%;%PATH%</path>
                                <requiresJdk>false</requiresJdk>
                                <!-- CGMES timestamped validation can retain large RDF models.
                                     A 64-bit JVM is required for multi-gigabyte heaps. -->
                                <requires64Bit>true</requires64Bit>
                                <minVersion>25</minVersion>
                                <opts>
                                    <opt>-Dprism.order=sw</opt>
                                    <!-- The default JVM heap is about one quarter of physical RAM.
                                         Leave headroom for Windows, JavaFX and native libraries while
                                         allowing large timestamped models to use the host capacity. -->
                                    <opt>-XX:MaxRAMPercentage=85.0</opt>
                                    <!-- launch4j starts the VM itself rather than through the
                                         java launcher, so the Enable-Native-Access manifest
                                         attribute does not reach it; the same grant has to be
                                         given as a VM option. -->
                                    <opt>--enable-native-access=ALL-UNNAMED</opt>
                                </opts>
                            </jre>
                            <versionInfo>
                                <fileVersion>${cimpal.version}</fileVersion>
                                <txtFileVersion>${cimpal.version}</txtFileVersion>
                                <fileDescription>CimPal GUI</fileDescription>
                                <copyright>gridDigIt</copyright>
                                <productVersion>${cimpal.version}</productVersion>
                                <txtProductVersion>${cimpal.version}</txtProductVersion>
                                <productName>CimPal</productName>
                                <companyName>gridDigIt</companyName>
                                <internalName>CimPal</internalName>
                                <originalFilename>CimPal.exe</originalFilename>
                                <trademarks>gridDigIt</trademarks>
                                <language>ENGLISH_US</language>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <configuration>
                    <mainClass>eu.griddigit.cimpal.main.application.CimPal</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- CGMES import, SVG diagram generation and the OpenLoadFlow implementation. -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-cgmes-conversion</artifactId>
        </dependency>
        <!-- CGMES conversion selects its triple-store implementation through ServiceLoader.
             The RDF4J provider is test-scoped upstream, so embedded applications must add it. -->
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-triple-store-impl-rdf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-iidm-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-open-loadflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-single-line-diagram-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.powsybl</groupId>
            <artifactId>powsybl-network-area-diagram</artifactId>
        </dependency>
        <!-- powsybl-commons exposes a ServiceLoader importer that uses Zstandard streams.
             It is optional upstream, but cannot be optional in CimPal because the shaded app
             discovers every registered importer at runtime. -->
        <dependency>
            <groupId>com.github.luben</groupId>
            <artifactId>zstd-jni</artifactId>
            <version>1.5.7-10</version>
        </dependency>
        <dependency>
            <groupId>eu.griddigit.CimPal</groupId>
            <artifactId>CimPal-Core</artifactId>
            <version>${cimpal.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.griddigit.CimPal</groupId>
            <artifactId>CimPal-CustomWriter</artifactId>
            <version>${cimpal.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>jena</artifactId>
            <version>${jena.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.apache.jena</groupId>
            <artifactId>jena-shacl</artifactId>
            <version>${jena.version}</version>
        </dependency>
<dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.activation</groupId>
                    <artifactId>jakarta.activation-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-lite</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-full</artifactId>
            <version>5.5.1</version>
        </dependency>
        <!-- The code uses org.apache.commons.math3 (ComparisonInstanceData). Declared
             explicitly rather than relied upon transitively via POI. Replaces a
             commons-math4-core 4.0-beta1 pin that was unused and, being a pre-release,
             carried no security-fix stream. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <!-- JavaFX — Windows (default, picked up automatically on the build runner) -->
