#
# Model B of the RDF Comparison smoke test: shapes-a.ttl with a changed minCount and a message.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cim: <http://iec.ch/TC57/CIM100#> .
@prefix ex: <http://example.org/shapes#> .

ex:LineShape a sh:NodeShape ;
    sh:targetClass cim:ACLineSegment ;
    sh:property ex:LineName .

ex:LineName a sh:PropertyShape ;
    sh:path cim:IdentifiedObject.name ;
    sh:minCount 2 ;
    sh:message "A line needs a name" .
