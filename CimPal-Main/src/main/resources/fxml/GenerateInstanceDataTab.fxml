<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.GenerateInstanceDataController"
      minHeight="0.0"
      minWidth="0.0">

  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">

    <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">

        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
            <columnConstraints>
                <!-- 0: labels. Fixed so every field in the tab starts on the same x. -->
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0"/>
                <!-- 1: the field. The only column that absorbs slack. minWidth 0 lets the tab shrink. -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                <!-- 2: Browse. Fixed so it never inflates into a banner. -->
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0"/>
            </columnConstraints>

            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Use method:" wrapText="true">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <Label fx:id="helpUseMethod" text="?" styleClass="help-badge"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2">
                <!-- prefWidth, not minWidth: minWidth="400" made the whole tab unable to shrink below it. -->
                <ChoiceBox fx:id="fcbGenMethodOptions" prefWidth="400.0"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </GridPane>

        <!-- Replaced Accordion with VBox so both TitledPanes can stay open -->
        <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" VBox.vgrow="ALWAYS">

            <TitledPane minHeight="0.0"
                        text="Create xlsx template from RDFS or dataset serialised in CIMXML"
                        VBox.vgrow="ALWAYS">

                <HBox minHeight="0.0" minWidth="0.0" spacing="16.0">

                    <VBox minWidth="0.0" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Loaded RDFS files"/>
                            <Label fx:id="helpLoadRdfs" text="?" styleClass="help-badge"/>
                        </HBox>
                        <ListView fx:id="ls_geni_rdfs" minHeight="100.0" minWidth="0.0"
                                  maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>
                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionLoadRDFSGen"
                                    text="Load RDFS"/>
                        </HBox>
                    </VBox>

                    <VBox minWidth="0.0" spacing="8.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Loaded Instance files"/>
                            <Label fx:id="helpLoadInstances" text="?" styleClass="help-badge"/>
                        </HBox>
                        <ListView fx:id="ls_geni_instances" minHeight="100.0" minWidth="0.0"
                                  maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS"/>
                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionLoadInstanceDataGen"
                                    text="Load Instance data"/>
                        </HBox>
                    </VBox>

                    <VBox minWidth="0.0" spacing="8.0" HBox.hgrow="ALWAYS">
                        <!--
                          The checkbox used to carry nodeOrientation="RIGHT_TO_LEFT" to pull itself to the
                          right edge, which also put its tick box after its text; label_geninfo then carried
                          LEFT_TO_RIGHT to undo the reading order. Both are gone.
                        -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <CheckBox fx:id="hideEmptySheets"
                                      disable="true"
                                      mnemonicParsing="false"
                                      text="Hide empty sheets"/>
                            <Label fx:id="helpHideEmptySheets" text="?" styleClass="help-badge"/>
                        </HBox>

                        <Label fx:id="label_geninfo"
                               maxWidth="1.7976931348623157E308"
                               styleClass="warning-text"
                               text="Load RDFS and/or Instance data to generate template."
                               wrapText="true"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar">
                            <Button minWidth="110.0"
                                    styleClass="primary-action"
                                    mnemonicParsing="false"
                                    onAction="#actionCreateXlsTemplate"
                                    text="Generate template"/>
                        </HBox>
                    </VBox>
                </HBox>
            </TitledPane>

            <!--
              minHeight USE_PREF_SIZE (-Infinity): the enclosing ScrollPane has fitToHeight, so
              the VBox distributes exactly the viewport height and will shrink a child to its
              minimum to make room. The pane above is the greedy one (its file lists carry
              vgrow=ALWAYS), and without this pin the sorting and export rows below were squeezed
              out of view entirely. Pinned to its preferred height, this pane always shows in
              full and the lists give up the space instead.
            -->
            <TitledPane minHeight="-Infinity"
                        text="Create CIMXML dataset based on xlsx template"
                        VBox.vgrow="NEVER">

                <VBox minHeight="0.0" minWidth="0.0" spacing="16.0">

                    <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
                        <columnConstraints>
                            <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0"/>
                        </columnConstraints>

                        <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <Label text="XLS template:" wrapText="true"/>
                            <Label fx:id="helpXlsTemplate" text="?" styleClass="help-badge"/>
                        </HBox>
                        <TextField fx:id="fsXlsTemplatePath" editable="false" maxWidth="1.7976931348623157E308"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionBrowseXlsTemplate"
                                text="Browse" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                        <HBox spacing="8.0" styleClass="option-label"
                              GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP">
                            <Label text="Sorting options:"/>
                            <Label fx:id="helpSortingOptions" text="?" styleClass="help-badge"/>
                        </HBox>
                        <!-- FlowPane so the options reflow instead of overflowing the tab. -->
                        <FlowPane hgap="16.0" vgap="8.0" styleClass="option-flow"
                                  GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"
                                  GridPane.valignment="TOP">
                            <CheckBox fx:id="fcbSortRDFGen" mnemonicParsing="false" selected="true"
                                      text="Sort alphabetically"/>
                            <HBox spacing="8.0">
                                <Label text="Sort by:"/>
                                <ChoiceBox fx:id="fcbRDFsortOptionsGen" prefWidth="200.0"/>
                            </HBox>
                            <CheckBox fx:id="fcbStripPrefixesGen" mnemonicParsing="false" selected="true"
                                      text="Strip declaration of unused prefixes"/>
                            <Label fx:id="helpStripPrefixes" text="?" styleClass="help-badge"/>
                        </FlowPane>

                        <FlowPane hgap="16.0" vgap="8.0" styleClass="option-flow"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"
                                  GridPane.valignment="TOP">
                            <CheckBox fx:id="fcbExportExtensionsGen" mnemonicParsing="false" selected="true"
                                      text="Export extensions (identified extensions in the template)"/>
                            <Label fx:id="helpExportExtensions" text="?" styleClass="help-badge"/>
                        </FlowPane>
                    </GridPane>

                    <!--
                      Always hidden. It lives in its own container rather than as a hidden grid row,
                      because an unmanaged row still contributes its vgap; an unmanaged container
                      contributes nothing at all.
                    -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false">
                        <Label text="Profile version:" wrapText="true"/>
                        <ChoiceBox fx:id="fcb_giVersion" prefWidth="400.0"/>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar">
                        <Button minWidth="110.0"
                                styleClass="primary-action"
                                mnemonicParsing="false"
                                onAction="#actionBtnRunGenerateInstance"
                                text="Create"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>

        <!-- Global Reset button for both sections -->
        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar" VBox.vgrow="NEVER">
            <Button
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBtnResetGenerateInstance"
                    text="Reset"/>
        </HBox>

    </VBox>
  </ScrollPane>
</VBox>
