<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.RDFComparisonController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox spacing="12.0"
          minHeight="0.0"
          minWidth="0.0"
          style="-fx-padding: 10;">
        <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="170.0" hgrow="NEVER" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints minWidth="95.0" prefWidth="95.0" hgrow="NEVER" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                    </rowConstraints>

                    <HBox spacing="5.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="RDF file A (Model A):" wrapText="true"/>
                        <Label fx:id="helpRdfFileA" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
                    </HBox>
                    <TextField fx:id="fPathRdffile1"
                               editable="false"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"
                               GridPane.hgrow="ALWAYS" />
                    <Button text="Browse"
                            mnemonicParsing="false"
                            onAction="#actionBrowseRDFfile1"
                            minWidth="95.0"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2" />

                    <HBox spacing="5.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="RDF file B (Model B):" wrapText="true"/>
                        <Label fx:id="helpRdfFileB" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
                    </HBox>
                    <TextField fx:id="fPathRdffile2"
                               editable="false"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"
                               GridPane.hgrow="ALWAYS" />
                    <Button text="Browse"
                            mnemonicParsing="false"
                            onAction="#actionBrowseRDFfile2"
                            minWidth="95.0"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2" />

                    <HBox spacing="5.0" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <Label text="RDF scope and format:" wrapText="true"/>
                        <Label fx:id="helpScopeFormat" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
                    </HBox>
                    <HBox spacing="10.0"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"
                          GridPane.columnSpan="2"
                          HBox.hgrow="ALWAYS">
                        <ChoiceBox fx:id="fcbRDFSformat"
                                   prefWidth="220.0"
                                   HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="fcbRDFcompareCimVersion"
                                  mnemonicParsing="false"
                                  text="Assume same CIM namespace"
                                  wrapText="true" />
                        <Label fx:id="helpSameCimNS" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
                    </HBox>
                </GridPane>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <CheckBox fx:id="fcbRDFcompareProfileNS"
                              mnemonicParsing="false"
                              text="Assume same Profile/Ontology namespace for prefix:"
                              wrapText="true" />
                    <Label fx:id="helpProfileNS" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
                    <TextField fx:id="fPrefixRDFCompare"
                               HBox.hgrow="ALWAYS" />
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="10.0" alignment="CENTER_RIGHT" VBox.vgrow="NEVER">
                    <Button fx:id="btnResetRDFComp"
                            mnemonicParsing="false"
                            onAction="#actionBtnResetRDFComp"
                            text="Reset"
                            minWidth="90.0" />
                    <Button fx:id="btnRunRDFcompare"
                            disable="true"
                            mnemonicParsing="false"
                            onAction="#actionBtnRunRDFcompare"
                            text="Run"
                            minWidth="90.0" />
                </HBox>
    </VBox>
  </ScrollPane>
</VBox>
