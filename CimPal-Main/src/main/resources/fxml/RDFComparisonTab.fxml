<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.RDFComparisonController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox spacing="16.0"
          minHeight="0.0"
          minWidth="0.0"
          styleClass="tab-root">
        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
                    <columnConstraints>
                        <!-- 0: labels. Fixed so every field in the tab starts on the same x. -->
                        <ColumnConstraints halignment="LEFT" minWidth="180.0" prefWidth="180.0" hgrow="NEVER" />
                        <!-- 1: the field. The only column that absorbs slack. minWidth 0 lets the tab shrink. -->
                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" />
                        <!-- 2: Browse. Fixed so it never inflates into a banner. -->
                        <ColumnConstraints halignment="RIGHT" minWidth="95.0" prefWidth="95.0" hgrow="NEVER" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                        <RowConstraints vgrow="NEVER" />
                    </rowConstraints>

                    <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="RDF file A (Model A):" wrapText="true"/>
                        <Label fx:id="helpRdfFileA" text="?" styleClass="help-badge"/>
                    </HBox>
                    <TextField fx:id="fPathRdffile1"
                               editable="false"
                               maxWidth="1.7976931348623157E308"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"
                               GridPane.hgrow="ALWAYS" />
                    <Button text="Browse"
                            mnemonicParsing="false"
                            onAction="#actionBrowseRDFfile1"
                            minWidth="95.0"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2" />

                    <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="RDF file B (Model B):" wrapText="true"/>
                        <Label fx:id="helpRdfFileB" text="?" styleClass="help-badge"/>
                    </HBox>
                    <TextField fx:id="fPathRdffile2"
                               editable="false"
                               maxWidth="1.7976931348623157E308"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"
                               GridPane.hgrow="ALWAYS" />
                    <Button text="Browse"
                            mnemonicParsing="false"
                            onAction="#actionBrowseRDFfile2"
                            minWidth="95.0"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2" />

                    <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <Label text="RDF scope and format:" wrapText="true"/>
                        <Label fx:id="helpScopeFormat" text="?" styleClass="help-badge"/>
                    </HBox>
                    <HBox spacing="8.0"
                          alignment="CENTER_LEFT"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"
                          GridPane.columnSpan="2">
                        <ChoiceBox fx:id="fcbRDFSformat"
                                   prefWidth="220.0" />
                        <CheckBox fx:id="fcbRDFcompareCimVersion"
                                  mnemonicParsing="false"
                                  text="Assume same CIM namespace"
                                  wrapText="true" />
                        <Label fx:id="helpSameCimNS" text="?" styleClass="help-badge"/>
                        <!-- A ChoiceBox has a natural width; the spacer absorbs the slack instead. -->
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                </GridPane>

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <CheckBox fx:id="fcbRDFcompareProfileNS"
                              mnemonicParsing="false"
                              text="Assume same Profile/Ontology namespace for prefix:"
                              wrapText="true" />
                    <Label fx:id="helpProfileNS" text="?" styleClass="help-badge"/>
                    <TextField fx:id="fPrefixRDFCompare"
                               HBox.hgrow="ALWAYS" />
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="8.0" alignment="CENTER_RIGHT" styleClass="action-bar" VBox.vgrow="NEVER">
                    <Button fx:id="btnResetRDFComp"
                            mnemonicParsing="false"
                            onAction="#actionBtnResetRDFComp"
                            text="Reset"
                            minWidth="95.0" />
                    <Button fx:id="btnRunRDFcompare"
                            disable="true"
                            mnemonicParsing="false"
                            onAction="#actionBtnRunRDFcompare"
                            text="Run"
                            styleClass="primary-action"
                            minWidth="110.0" />
                </HBox>
    </VBox>
  </ScrollPane>
</VBox>
