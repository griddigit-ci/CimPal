<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="0.0" minWidth="0.0" spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eu.griddigit.cimpal.main.application.controllers.taskWizardControllers.TaskInputController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <ScrollPane fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
      <VBox fx:id="vBoxForTaskInputs" minHeight="0.0" minWidth="0.0" spacing="10" />
   </ScrollPane>
   <HBox spacing="10" VBox.vgrow="NEVER">
      <Button fx:id="buttonSelectWorkingDirectory" mnemonicParsing="false" onAction="#selectWorkingDirectory" text="Select Working Directory" />
      <Button mnemonicParsing="false" onAction="#selectOutputDirectory" text="Select Output Directory" />
      <Region HBox.hgrow="ALWAYS" />
      <CheckBox fx:id="saveToZip" mnemonicParsing="false" selected="true" text="Compress files to zip" />
   </HBox>
</VBox>
