<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<TitledPane animated="false" collapsible="false" maxWidth="1.7976931348623157E308" text="Rename"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eu.griddigit.cimpal.main.application.controllers.taskWizardControllers.RenameController">
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="220.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
            <ColumnConstraints hgrow="NEVER" minWidth="152.0"/>
            <ColumnConstraints hgrow="NEVER" minWidth="180.0"/>
        </columnConstraints>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>

        <Label text="Rename multiply config file:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="loadedXMLFile" editable="false" maxWidth="1.7976931348623157E308"
                   GridPane.columnIndex="1" GridPane.rowIndex="0">
            <font>
                <Font name="Consolas" size="12.0"/>
            </font>
        </TextField>
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#browseRenameMultiplyConfigXML" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <CheckBox fx:id="saveResult" mnemonicParsing="false" selected="true"
                  text="Save Result to Working Dir" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
    </GridPane>
</TitledPane>
