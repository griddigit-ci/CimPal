<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane animated="false" collapsible="false" maxWidth="1.7976931348623157E308" text="Multiply CGM From Config File"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eu.griddigit.cimpal.main.application.controllers.taskWizardControllers.MultiplyCGMFromConfigFileController">
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="200.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
            <ColumnConstraints hgrow="NEVER" minWidth="152.0"/>
            <ColumnConstraints hgrow="NEVER" minWidth="180.0"/>
        </columnConstraints>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>

        <Label text="Multiply CGM config XLS:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="loadedXMLFile" editable="false" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actionBrowseMultiplyCGMFiles" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <CheckBox fx:id="saveResult" mnemonicParsing="false" selected="true"
                  text="Save Result to Working Dir" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <Label text="Loaded MAS File:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="loadedMasFile" editable="false" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button fx:id="browseMasFile" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                onAction="#actionBrowseMasFiles" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <CheckBox fx:id="persistentEQflag" mnemonicParsing="false" text="Persistent EQ"
                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <Label text="TPBD ID:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="tpbdId" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#browsTPBDFile" text="Browse"
                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <CheckBox fx:id="useGeneratedMasFile" mnemonicParsing="false" text="Use generated MAS"
                  GridPane.columnIndex="3" GridPane.rowIndex="2"/>
    </GridPane>
</TitledPane>
