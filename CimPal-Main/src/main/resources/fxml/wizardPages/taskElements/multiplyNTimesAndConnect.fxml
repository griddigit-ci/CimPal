<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TitledPane animated="false" collapsible="false" maxWidth="1.7976931348623157E308" text="Multiply Base Model N Times And Connect"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eu.griddigit.cimpal.main.application.controllers.taskWizardControllers.MultiplyNTimesAndConnectController">
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="260.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
            <ColumnConstraints hgrow="NEVER" minWidth="180.0"/>
        </columnConstraints>
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>

        <Label text="Number of models in the result:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="timesToMultiply" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <tooltip>
                <Tooltip text="How many models the result holds in total, counting the base model. 3 gives the base model and 2 copies, chained one after another."/>
            </tooltip>
        </TextField>
        <CheckBox fx:id="saveResult" mnemonicParsing="false" selected="true"
                  text="Save Result to Working Dir" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label text="Connect at Connectivity Node Id:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="connectivityNodeId" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <tooltip>
                <Tooltip text="The connectivity node in the base model that the copies are chained onto, with or without the leading underscore."/>
            </tooltip>
        </TextField>

        <Label text="The base model is kept as it is and counts as one. Every copy gets newly generated rdf:IDs and mRIDs, and is joined to the one before it by a new line between this connectivity node and the copy of it, at the same base voltage."
               wrapText="true" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2"/>
    </GridPane>
</TitledPane>
