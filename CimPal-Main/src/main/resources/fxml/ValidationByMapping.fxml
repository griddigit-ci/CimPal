<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="0.0" minWidth="0.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.ValidationByMappingController">

  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">

    <VBox spacing="16.0" minHeight="0.0" minWidth="0.0" styleClass="tab-root">

        <!--
          One grid instead of eight HBox rows, each of which used to carry its own
          HBox minWidth="170" to fake a label column. The column constraint does that once.
        -->
        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
            <columnConstraints>
                <!-- 0: labels. Fixed so every field in the tab starts on the same x. -->
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0"/>
                <!-- 1: the field. The only column that absorbs slack. minWidth 0 lets the tab shrink. -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                <!-- 2: Browse. Fixed so it never inflates into a banner. -->
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0"/>
            </columnConstraints>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Validation workflow:" wrapText="true"/>
                <Label fx:id="helpValidationWorkflow"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  GridPane.columnSpan="2">
                <ChoiceBox fx:id="cbValidationWorkflow" prefWidth="350.0"/>
                <!-- A ChoiceBox has a natural width; the spacer absorbs the slack instead. -->
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!--
              Manual-selection row. Only the "Validate by manual selection" workflow uses
              explicitly chosen constraint files; the two mapping workflows resolve them from
              the mapping CSV instead. The row stays in place and is disabled rather than
              hidden, so the form does not reflow when the workflow changes.
            -->
            <HBox fx:id="rowShaclConstraintFilesLabel" spacing="8.0" alignment="CENTER_LEFT"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="SHACL Constraint files (.ttl):" wrapText="true"/>
                <Label fx:id="helpShaclConstraintFiles"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfShaclConstraintFiles"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Select one or more SHACL constraint files (.ttl)"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Button fx:id="btnBrowseShaclConstraintFiles"
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowseShaclConstraintFiles"
                    text="Browse"
                    GridPane.rowIndex="1" GridPane.columnIndex="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                <Label text="Mapping CSV file:" wrapText="true"/>
                <Label fx:id="helpMappingCsvFile"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfMappingCsvFile"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Select a .csv mapping file"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Button fx:id="btnBrowseMappingCsv"
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowseMappingCsv"
                    text="Browse"
                    GridPane.rowIndex="2" GridPane.columnIndex="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="0">
                <Label text="Models / input root folder:" wrapText="true"/>
                <Label fx:id="helpModelsInputFolder"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfModelsInputFolder"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Select model root folder or timestamped input root folder"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Button minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowseModelsInputFolder"
                    text="Browse"
                    GridPane.rowIndex="3" GridPane.columnIndex="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="0">
                <Label text="Constraints root folder:" wrapText="true"/>
                <Label fx:id="helpConstraintsRootFolder"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfConstraintsRootFolder"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Select constraints root folder"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Button fx:id="btnBrowseConstraintsRootFolder"
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowseConstraintsRootFolder"
                    text="Browse"
                    GridPane.rowIndex="4" GridPane.columnIndex="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="5" GridPane.columnIndex="0">
                <Label text="Output folder:" wrapText="true"/>
                <Label fx:id="helpOutputFolder"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfOutputFolder"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Select output folder"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Button fx:id="btnBrowseOutputFolder"
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowseOutputFolder"
                    text="Browse"
                    GridPane.rowIndex="5" GridPane.columnIndex="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="0">
                <Label text="Datatype map:" wrapText="true"/>
                <Label fx:id="helpDatatypeMap"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="6" GridPane.columnIndex="1"
                  GridPane.columnSpan="2">
                <ChoiceBox fx:id="cbDatatypeMap" prefWidth="350.0"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="0">
                <Label text="XML base URI:" wrapText="true"/>
                <Label fx:id="helpXmlBaseUri"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfXmlBaseUri"
                       maxWidth="1.7976931348623157E308"
                       text="http://iec.ch/TC57/CIM100"
                       GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.rowIndex="8" GridPane.columnIndex="0">
                <Label text="Previous comparison CSV:" wrapText="true"/>
                <Label fx:id="helpPreviousComparisonCsv"
                       text="?"
                       styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="tfPreviousComparisonCsv"
                       editable="false"
                       maxWidth="1.7976931348623157E308"
                       promptText="Optional - previous run totals (region,dataset,total). Timestamped workflow only."
                       GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            <Button fx:id="btnBrowsePreviousComparisonCsv"
                    minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionBrowsePreviousComparisonCsv"
                    text="Browse"
                    GridPane.rowIndex="8" GridPane.columnIndex="2"/>
        </GridPane>

        <!--
          Manual-selection extras. Unlike the constraint-files row above these are hidden
          rather than disabled: an empty file tree and an inapplicable export option are
          noise in the two mapping workflows, and both are unmanaged when hidden so they
          give their space back to the tab rather than leaving a gap.
        -->
        <HBox fx:id="rowExportModelReports" spacing="8.0" alignment="CENTER_LEFT"
              visible="false" managed="false" VBox.vgrow="NEVER">
            <CheckBox fx:id="cbExportReports" mnemonicParsing="false" selected="true"
                      text="Export model validation reports"/>
            <Label fx:id="helpExportReports" text="?" styleClass="help-badge"/>
        </HBox>

        <TreeView fx:id="treeViewShaclFiles" maxWidth="1.7976931348623157E308" minHeight="100.0"
                  showRoot="false" visible="false" managed="false" VBox.vgrow="ALWAYS"/>

        <Region fx:id="spacerBelowForm" VBox.vgrow="ALWAYS"/>

        <!-- maxWidth, not prefWidth: prefWidth="Infinity" made the whole tab report an
             infinite preferred width. maxWidth is what makes it stretch to the container. -->
        <ProgressBar fx:id="pbValidationByMapping" maxWidth="Infinity" progress="0.0"/>

        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar" VBox.vgrow="NEVER">
            <Button minWidth="95.0"
                    mnemonicParsing="false"
                    onAction="#actionResetValidationByMapping"
                    text="Reset"/>

            <Button fx:id="btnRunValidationByMapping"
                    minWidth="110.0"
                    styleClass="primary-action"
                    mnemonicParsing="false"
                    onAction="#actionRunValidationByMapping"
                    text="Run"/>
        </HBox>

    </VBox>
  </ScrollPane>
</VBox>
