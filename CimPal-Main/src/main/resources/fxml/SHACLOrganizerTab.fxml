<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.SHACLOrganizerController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox minHeight="0.0" minWidth="0.0" spacing="10.0">
        <HBox spacing="10.0">
            <padding>
                <Insets left="5.0" right="5.0" top="5.0" />
            </padding>
            <Label minWidth="90.0" text="SHACL files:" wrapText="true" />
            <Label fx:id="helpShaclFiles" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
            <TextField fx:id="fPathShaclFilesToOrganize" editable="false" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#actionBrowseShaclFilesToOrganize" text="Browse" />
        </HBox>
        <HBox spacing="10.0">
            <padding>
                <Insets left="5.0" right="5.0" top="5.0" />
            </padding>
            <Label minWidth="90.0" text="Excel template file:" wrapText="true" />
            <Label fx:id="helpExcelTemplate" text="?" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: #808080; -fx-border-radius: 20; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-alignment: center; -fx-min-width: 18px; -fx-min-height: 18px; -fx-pref-width: 18px; -fx-pref-height: 18px; -fx-cursor: hand;"/>
            <TextField fx:id="fPathXLSfileForShacl" editable="false" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#actionBrowseExcelfileForShacl" text="Browse" />
        </HBox>
        <HBox spacing="10.0" visible="false">
            <padding>
                <Insets left="5.0" right="5.0" top="5.0" />
            </padding>
            <Label minWidth="90.0" text="Base URI - Shape graph:" wrapText="true" />
            <TextField fx:id="fbaseURIShacl" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox spacing="10.0" visible="false">
            <padding>
                <Insets left="5.0" right="5.0" top="5.0" />
            </padding>
            <Label minWidth="90.0" text="Namespace information for the resulted Shape graph:" wrapText="true" />
        </HBox>
        <HBox spacing="10.0" visible="false">
            <padding>
                <Insets left="5.0" right="5.0" top="5.0" />
            </padding>
            <Label minWidth="90.0" text="Prefix:" wrapText="true" />
            <TextField fx:id="fPrefixShaclOrganizer" prefWidth="70.0" />
            <Label minWidth="90.0" text="Namespace:" wrapText="true" />
            <TextField fx:id="fNSShaclOrganizer" HBox.hgrow="ALWAYS" />
        </HBox>
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="BOTTOM_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0" VBox.vgrow="NEVER">
            <VBox.margin>
                <Insets bottom="5.0" right="5.0" />
            </VBox.margin>
            <Button fx:id="btnRunShaclOrganizer" minWidth="60.0" mnemonicParsing="false" onAction="#actionBtnRunShaclOrganizer" text="Run" />
            <Button fx:id="btnResetShaclOrganizer" minWidth="60.0" mnemonicParsing="false" onAction="#actionBtnResetShaclOrganizer" text="Reset" />
        </HBox>
    </VBox>
  </ScrollPane>
</VBox>
