<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.SHACLOrganizerController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">

        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
            <columnConstraints>
                <!-- 0: labels. Fixed so every row's field starts on the same x. -->
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0" />
                <!-- 1: the field. The only column that absorbs slack. minWidth 0 lets the tab shrink. -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" />
                <!-- 2: Browse. Fixed so it never inflates into a banner. -->
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0" />
            </columnConstraints>

            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="SHACL files:" wrapText="true" />
                <Label fx:id="helpShaclFiles" text="?" styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="fPathShaclFilesToOrganize" editable="false" maxWidth="1.7976931348623157E308"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionBrowseShaclFilesToOrganize" text="Browse"
                    GridPane.rowIndex="0" GridPane.columnIndex="2" />

            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Excel template file:" wrapText="true" />
                <Label fx:id="helpExcelTemplate" text="?" styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="fPathXLSfileForShacl" editable="false" maxWidth="1.7976931348623157E308"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionBrowseExcelfileForShacl" text="Browse"
                    GridPane.rowIndex="1" GridPane.columnIndex="2" />
        </GridPane>

        <!--
          The namespace rows below have always been hidden. They live in their own grid rather than
          as hidden rows of the grid above because an unmanaged row still contributes its vgap;
          an unmanaged container contributes nothing at all.
        -->
        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid" visible="false" managed="false">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" />
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0" />
            </columnConstraints>

            <Label text="Base URI - Shape graph:" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="fbaseURIShacl" maxWidth="1.7976931348623157E308"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2" />

            <Label text="Namespace information for the resulted Shape graph:" wrapText="true" styleClass="section-title"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="3" />

            <Label text="Prefix:" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2">
                <TextField fx:id="fPrefixShaclOrganizer" prefWidth="70.0" />
                <Label text="Namespace:" wrapText="true" />
                <TextField fx:id="fNSShaclOrganizer" HBox.hgrow="ALWAYS" />
            </HBox>
        </GridPane>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar" VBox.vgrow="NEVER">
            <Button fx:id="btnResetShaclOrganizer" minWidth="95.0" mnemonicParsing="false" onAction="#actionBtnResetShaclOrganizer" text="Reset" />
            <Button fx:id="btnRunShaclOrganizer" minWidth="110.0" styleClass="primary-action" mnemonicParsing="false" onAction="#actionBtnRunShaclOrganizer" text="Run" />
        </HBox>
    </VBox>
  </ScrollPane>
</VBox>
