<?import eu.griddigit.cimpal.main.gui.RdfGraphView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="tab-root"
            fx:controller="eu.griddigit.cimpal.main.application.controllers.RDFVisualisationController">
   <top>
      <VBox spacing="8.0" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="8.0"/>
         </BorderPane.margin>

         <FlowPane hgap="8.0" vgap="8.0">
            <Button mnemonicParsing="false" onAction="#actionLoadFiles" text="Load RDF files..."/>
            <Label fx:id="helpLoad" styleClass="help-badge" text="?"/>
            <Label text="Base URI:"/>
            <ChoiceBox fx:id="cbBaseUri" prefWidth="130.0"/>
            <TextField fx:id="tfBaseUri" prefWidth="300.0"/>
            <Button mnemonicParsing="false" onAction="#actionAddFiles" text="Add files..."/>
            <Button fx:id="btnMergeGraphs" mnemonicParsing="false" onAction="#actionMergeGraphs"
                    text="Merge"/>
            <Button fx:id="btnRemoveGraph" mnemonicParsing="false" onAction="#actionRemoveSelectedGraph"
                    text="Remove selected"/>
            <Button fx:id="btnClearAll" mnemonicParsing="false" onAction="#actionClearAll" text="Reset"/>
            <Button fx:id="btnToggleTreePane" mnemonicParsing="false"
                    onAction="#actionToggleTreePane" text="Hide graph browser"/>
            <Label fx:id="helpPanes" styleClass="help-badge" text="?"/>
         </FlowPane>

         <!--
           Filters are applied on Enter or on Apply rather than on every keystroke: a CGMES
           dataset is hundreds of thousands of triples and re-scanning it per character typed
           would make the fields unusable.

           A FlowPane rather than a grid: four short fields fit on one line on a normal window
           and reflow onto a second line when the window is narrow, instead of clipping.
         -->
         <TitledPane animated="false" text="Filters (expand to edit)" expanded="false">
         <VBox spacing="8.0">
         <FlowPane hgap="12.0" vgap="8.0">
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <Label text="Subject contains:"/>
               <TextField fx:id="tfSubjectFilter" onAction="#actionApplyFilters" prefWidth="170.0"
                          promptText="URI or local name"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <Label text="Predicate contains:"/>
               <TextField fx:id="tfPredicateFilter" onAction="#actionApplyFilters" prefWidth="170.0"
                          promptText="URI or local name"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <Label text="Object contains:"/>
               <TextField fx:id="tfObjectFilter" onAction="#actionApplyFilters" prefWidth="170.0"
                          promptText="URI, literal value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <Label text="Full text search:"/>
               <TextField fx:id="tfFullTextSearch" onAction="#actionApplyFilters" prefWidth="170.0"
                          promptText="any subject, predicate or object"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <Label text="SPARQL subject filter:"/>
               <Button mnemonicParsing="false" onAction="#actionLoadSparqlQuery" text="Load query..."/>
               <Label fx:id="helpSparqlFilter" styleClass="help-badge" text="?"/>
               <TextArea fx:id="taSparqlFilter" prefColumnCount="32" prefRowCount="2"
                         promptText="Optional SELECT ?s WHERE { ... }" wrapText="false"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <Button fx:id="btnApplyFilters" defaultButton="true" mnemonicParsing="false"
                       onAction="#actionApplyFilters" styleClass="primary-action" text="Apply"/>
               <Button mnemonicParsing="false" onAction="#actionClearFilters" text="Clear filters"/>
               <Label fx:id="lblGraphScope" text="Scope: all loaded graphs"/>
               <Label fx:id="helpFilters" styleClass="help-badge" text="?"/>
            </HBox>
         </FlowPane>

         <!--
           The two panes on the left are removed from the SplitPane rather than merely hidden
           when folded away: an unmanaged SplitPane item still holds its division, so hiding
           alone would not give the diagram the freed width.

           Plain buttons rather than toggles, and always in this fixed spot: the label states
           what pressing them will do, so restoring a folded-away pane is never a hunt. Each
           pane header also carries a chevron for collapsing that pane in place.
         -->
         </VBox>
         </TitledPane>
      </VBox>
   </top>

   <center>
      <!--
        Divider positions are set from the controller, not here: the FXML attribute is parsed as a
        single double, so a two-divider split cannot be expressed as an attribute.
      -->
      <SplitPane fx:id="visualisationSplitPane" minHeight="0.0"
                 minWidth="0.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="8.0"/>
         </BorderPane.margin>

         <VBox fx:id="treePane" minHeight="0.0" minWidth="0.0" spacing="8.0">
            <padding>
               <Insets left="8.0" right="8.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <Label styleClass="section-title" text="Graph browser"/>
               <Label fx:id="helpTree" styleClass="help-badge" text="?"/>
               <Region HBox.hgrow="ALWAYS"/>
               <Label text="Group by:"/>
               <!-- Reshapes the rows already scanned, so changing it never rescans the models. -->
               <ComboBox fx:id="cbGrouping" prefWidth="200.0"/>
               <Button fx:id="btnToggleAllSubjects" mnemonicParsing="false" onAction="#actionToggleAllSubjects"
                       styleClass="icon-button" text="∞">
                  <tooltip><Tooltip text="Show all matching subjects in the browser"/></tooltip>
               </Button>
               <Button mnemonicParsing="false" onAction="#actionExpandSelected" styleClass="icon-button" text="↕">
                  <tooltip><Tooltip text="Expand selected"/></tooltip>
               </Button>
               <Button mnemonicParsing="false" onAction="#actionCollapseAll" styleClass="icon-button" text="⇱">
                  <tooltip><Tooltip text="Collapse all"/></tooltip>
               </Button>
               <Button mnemonicParsing="false" onAction="#actionCopySelected" styleClass="icon-button" text="⧉">
                  <tooltip><Tooltip text="Copy selected value"/></tooltip>
               </Button>
               <Button mnemonicParsing="false" onAction="#actionToggleTreePane"
                       styleClass="icon-button" text="&#171;">
                  <tooltip>
                     <Tooltip text="Fold this pane away (Show graph browser brings it back)"/>
                  </tooltip>
               </Button>
            </HBox>
            <TreeView fx:id="tvGraph" minHeight="0.0" minWidth="0.0" showRoot="false" VBox.vgrow="ALWAYS"/>
         </VBox>

         <VBox fx:id="graphViewPane" minHeight="0.0" minWidth="0.0" spacing="8.0">
            <padding>
               <Insets left="8.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <Button fx:id="btnToggleGraphContent" mnemonicParsing="false"
                       onAction="#actionToggleGraphContent" styleClass="section-title" text="Table view"/>
               <Label fx:id="helpGraphView" styleClass="help-badge" text="?"/>
               <CheckBox fx:id="cbAutoRefresh" mnemonicParsing="false" onAction="#actionAutoRefreshChanged" styleClass="icon-button" text="↻">
                  <tooltip><Tooltip text="Automatically refresh the active Graph or Table view when the tree selection changes"/></tooltip>
               </CheckBox>
               <Region HBox.hgrow="ALWAYS"/>
               <Label text="Layout:"/>
               <ComboBox fx:id="cbGraphLayout" onAction="#actionChangeGraphLayout" prefWidth="140.0"/>
               <Button fx:id="btnToggleGraphMetadata" mnemonicParsing="false" onAction="#actionToggleGraphMetadata"
                       styleClass="icon-button" text="G">
                  <tooltip><Tooltip text="Show or hide graph metadata in the table"/></tooltip>
               </Button>
               <Button fx:id="btnExportTable" mnemonicParsing="false" onAction="#actionExportTable"
                       styleClass="icon-button" text="XLS" visible="false" managed="false">
                  <tooltip><Tooltip text="Export the current table to Excel"/></tooltip>
               </Button>
               <CheckBox fx:id="cbIncludeLiterals" mnemonicParsing="false"
                         onAction="#actionRedrawGraphView" text="Include literals"/>
               <Button mnemonicParsing="false" onAction="#actionZoomIn" text="+"/>
               <Button mnemonicParsing="false" onAction="#actionZoomOut" text="-"/>
               <Button mnemonicParsing="false" onAction="#actionFitGraphView" text="Fit"/>
            </HBox>
            <StackPane minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
               <RdfGraphView fx:id="graphView" minHeight="0.0" minWidth="0.0"/>
               <TableView fx:id="tvGraphData" managed="false" minHeight="0.0" minWidth="0.0" visible="false"/>
            </StackPane>
         </VBox>
      </SplitPane>
   </center>

</BorderPane>
