<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eu.griddigit.cimpal.main.application.PreferencesController">
   <HBox minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
      <TabPane minHeight="0.0" minWidth="0.0" tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS">
         <Tab text="CIM related">
               <VBox minHeight="0.0" minWidth="0.0">
                  <HBox fillHeight="false">
                     <VBox.margin>
                        <Insets bottom="5.0" top="5.0"/>
                     </VBox.margin>
                     <Label minWidth="100.0" text="CIM namespace:" HBox.hgrow="NEVER">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="fCIMnamespace" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <HBox fillHeight="false">
                     <VBox.margin>
                        <Insets bottom="5.0"/>
                     </VBox.margin>
                     <Label minWidth="100.0" text="cims namespace:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="fcimsnamespace" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <HBox fillHeight="false">
                     <Label minWidth="100.0" text="rdf namespace:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="frdfnamespace" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <HBox fillHeight="false">
                     <Label minWidth="100.0"
                            text="Prefix and URI for the namespace of shapes related to IdentifiedObject:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                  </HBox>
                  <HBox fillHeight="false">
                     <Label minWidth="100.0" text="prefix:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="fIOprefix" prefWidth="120.0">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                     <Label minWidth="50.0" text="URI:"/>
                     <TextField fx:id="fIOuri" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <HBox fillHeight="false">
                     <Label minWidth="100.0" text="Namespaces for extensions:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                  </HBox>
                  <HBox fillHeight="false">
                     <VBox.margin>
                        <Insets bottom="5.0"/>
                     </VBox.margin>
                     <Label minWidth="100.0" text="prefix:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="fprefixEU" prefWidth="120.0">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                     <Label minWidth="50.0" text="URI:"/>
                     <TextField fx:id="furiEU" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <HBox fillHeight="false">
                     <Label minWidth="100.0" text="prefix:">
                        <HBox.margin>
                           <Insets left="5.0"/>
                        </HBox.margin>
                     </Label>
                     <TextField fx:id="fprefixOther" prefWidth="120.0">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                     <Label minWidth="50.0" text="URI:"/>
                     <TextField fx:id="furiOther" HBox.hgrow="ALWAYS">
                        <HBox.margin>
                           <Insets right="5.0"/>
                        </HBox.margin>
                     </TextField>
                  </HBox>
                  <Region VBox.vgrow="ALWAYS"/>
               </VBox>
         </Tab>
         <Tab disable="true" text="Application">
            <AnchorPane minHeight="0.0" minWidth="0.0"/>
         </Tab>
      </TabPane>
   </HBox>
   <HBox>
      <ButtonBar prefHeight="40.0" HBox.hgrow="ALWAYS">
         <buttons>
            <Button mnemonicParsing="false" onAction="#actionBtnOK" text="OK"/>
            <Button mnemonicParsing="false" onAction="#actionBtnDefault" text="Default"/>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#actionBtnCancel"
                    text="Cancel"/>
         </buttons>
         <HBox.margin>
            <Insets right="5.0"/>
         </HBox.margin>
      </ButtonBar>
   </HBox>
</VBox>
