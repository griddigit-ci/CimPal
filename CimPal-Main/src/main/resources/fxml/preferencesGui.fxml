<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="400.0" minWidth="600.0" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eu.griddigit.cimpal.main.application.PreferencesController">
   <HBox minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
      <TabPane minHeight="0.0" minWidth="0.0" tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS">
         <Tab text="CIM related">
            <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">
               <!--
                 One grid instead of nine HBox rows, each of which carried its own
                 left="5"/right="5" margins to fake a label column and a right gutter.
               -->
               <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
                  <columnConstraints>
                     <!-- 0: labels. Fixed so every field in the dialog starts on the same x. -->
                     <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0"/>
                     <!-- 1: the prefix fields. Narrow by nature, so it never grows. -->
                     <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="120.0" prefWidth="120.0"/>
                     <!-- 2: the inline "URI:" label. -->
                     <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="50.0" prefWidth="50.0"/>
                     <!-- 3: the URI fields. The only column that absorbs slack. -->
                     <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                  </columnConstraints>

                  <Label text="CIM namespace:" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                  <TextField fx:id="fCIMnamespace" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                  <Label text="cims namespace:" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                  <TextField fx:id="fcimsnamespace" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                  <Label text="rdf namespace:" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                  <TextField fx:id="frdfnamespace" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                  <Label text="Prefix and URI for the namespace of shapes related to IdentifiedObject:"
                         styleClass="section-title" wrapText="true"
                         GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4"/>

                  <Label text="prefix:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                  <TextField fx:id="fIOprefix" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                  <Label text="URI:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                  <TextField fx:id="fIOuri" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="4" GridPane.columnIndex="3"/>

                  <Label text="Namespaces for extensions:" styleClass="section-title" wrapText="true"
                         GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="4"/>

                  <Label text="prefix:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                  <TextField fx:id="fprefixEU" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                  <Label text="URI:" GridPane.rowIndex="6" GridPane.columnIndex="2"/>
                  <TextField fx:id="furiEU" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="6" GridPane.columnIndex="3"/>

                  <Label text="prefix:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                  <TextField fx:id="fprefixOther" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                  <Label text="URI:" GridPane.rowIndex="7" GridPane.columnIndex="2"/>
                  <TextField fx:id="furiOther" maxWidth="1.7976931348623157E308"
                             GridPane.rowIndex="7" GridPane.columnIndex="3"/>
               </GridPane>
               <Region VBox.vgrow="ALWAYS"/>
            </VBox>
         </Tab>
         <Tab text="Application">
            <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">
               <TitledPane animated="false" collapsible="false" maxWidth="1.7976931348623157E308"
                           minHeight="0.0" text="Themes" VBox.vgrow="ALWAYS">
                  <VBox minHeight="0.0" spacing="8.0">
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
                     </padding>
                     <Label text="Applied immediately as a preview. Press OK to keep it, Cancel to revert."
                            wrapText="true"/>
                     <fx:define>
                        <ToggleGroup fx:id="themeToggleGroup"/>
                     </fx:define>
                     <!-- Populated from ThemeManager.Theme.values() by PreferencesController. -->
                     <ScrollPane fitToWidth="true" minHeight="0.0" VBox.vgrow="ALWAYS">
                        <VBox fx:id="themeRadioContainer" minHeight="0.0" spacing="4.0"/>
                     </ScrollPane>
                  </VBox>
               </TitledPane>

               <TitledPane animated="false" collapsible="false" maxWidth="1.7976931348623157E308"
                           minHeight="0.0" text="Remembered locations" VBox.vgrow="NEVER">
                  <VBox minHeight="0.0" spacing="8.0">
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
                     </padding>
                     <Label text="CimPal remembers the folder each field and each file dialog last used, so they open where you left them."
                            wrapText="true"/>
                     <Label fx:id="lblRememberedLocations" text="" wrapText="true"/>
                     <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button minWidth="110.0" mnemonicParsing="false"
                                onAction="#actionClearRememberedLocations"
                                text="Clear remembered locations"/>
                     </HBox>
                  </VBox>
               </TitledPane>
            </VBox>
         </Tab>
         <Tab text="AI Assistant">
            <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">
               <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
                  <columnConstraints>
                     <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0"/>
                     <ColumnConstraints hgrow="ALWAYS" minWidth="0.0"/>
                  </columnConstraints>
                  <Label text="Fast response tokens:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                  <TextField fx:id="fAiFastTokens" prefWidth="140.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                  <Label text="Normal response tokens:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                  <TextField fx:id="fAiNormalTokens" prefWidth="140.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                  <Label text="Complete response tokens:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                  <TextField fx:id="fAiCompleteTokens" prefWidth="140.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                  <Label fx:id="helpAiResponseTokens" text="?" styleClass="help-badge" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                  <Label text="Validation results to include:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                  <TextField fx:id="fAiValidationMaxResults" prefWidth="140.0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                  <Label text="Properties per focus node:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                  <TextField fx:id="fAiValidationMaxProperties" prefWidth="140.0" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                  <Label text="Knowledge sources:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                  <TextArea fx:id="fAiKnowledgeSources" prefRowCount="5" promptText="One local folder, public URL, or GitHub repository URL[#branch] per line" wrapText="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                  <HBox spacing="8.0" GridPane.rowIndex="7" GridPane.columnIndex="1"><Button mnemonicParsing="false" onAction="#actionAddKnowledgeFolder" text="Add local folder..."/><CheckBox fx:id="cbAiUseRemoteSources" mnemonicParsing="false" text="Include configured public remote sources"/></HBox>
                  <HBox spacing="8.0" GridPane.rowIndex="8" GridPane.columnIndex="1"><Button mnemonicParsing="false" onAction="#actionRefreshRemoteSources" text="Refresh remote sources now"/><CheckBox fx:id="cbAiRefreshRemoteOnStartup" mnemonicParsing="false" text="Refresh at application start"/></HBox>
                  <Label fx:id="lblAiKnowledgeStatus" wrapText="true" GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
                  <Label text="Local folders are searched on this computer. GitHub repositories are shallow-cloned into CimPal's local cache; public URLs are fetched only when enabled. Neither your model data nor your question is sent to them." wrapText="true" GridPane.rowIndex="10" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
               </GridPane>
               <Region VBox.vgrow="ALWAYS"/>
            </VBox>
         </Tab>
      </TabPane>
   </HBox>
   <HBox>
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0"/>
      </padding>
      <ButtonBar prefHeight="40.0" styleClass="action-bar" HBox.hgrow="ALWAYS">
         <buttons>
            <Button mnemonicParsing="false" onAction="#actionBtnOK" text="OK"/>
            <Button mnemonicParsing="false" onAction="#actionBtnDefault" text="Default"/>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#actionBtnCancel"
                    text="Cancel"/>
         </buttons>
      </ButtonBar>
   </HBox>
</VBox>
