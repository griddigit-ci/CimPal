<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="eu.griddigit.cimpal.main.application.controllers.RDFSUnionController" minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
    <VBox spacing="16" styleClass="tab-root">
      <GridPane hgap="8" vgap="8" styleClass="form-grid">
        <columnConstraints><ColumnConstraints minWidth="180" prefWidth="180"/><ColumnConstraints hgrow="ALWAYS" minWidth="0"/><ColumnConstraints minWidth="95" prefWidth="95"/></columnConstraints>
        <HBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0"><Label text="Union type:"/><Label fx:id="helpUnionType" text="?" styleClass="help-badge"/></HBox>
        <HBox spacing="16" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2"><RadioButton fx:id="simpleUnionRadio" text="Simple union"/><RadioButton fx:id="detailedUnionRadio" text="Detailed RDFS union"/></HBox>
        <HBox fx:id="simpleUnionInput" spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="3"><HBox minWidth="180" spacing="6"><Label text="Select RDFS datasets:"/><Label fx:id="helpSimpleDatasets" text="?" styleClass="help-badge"/></HBox><TextField fx:id="simpleDatasetsTextField" editable="false" HBox.hgrow="ALWAYS"/><Button text="Browse" minWidth="95" onAction="#browseSimpleDatasets"/></HBox>
        <VBox fx:id="detailedUnionInput" spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="3">
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Main RDFS dataset:"/><Label fx:id="helpMainDataset" text="?" styleClass="help-badge"/></HBox><TextField fx:id="mainDatasetTextField" editable="false" HBox.hgrow="ALWAYS"/><Button text="Browse" minWidth="95" onAction="#browseMainDataset"/></HBox>
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Deviation RDFS dataset:"/><Label fx:id="helpDeviationDataset" text="?" styleClass="help-badge"/></HBox><TextField fx:id="deviationDatasetTextField" editable="false" HBox.hgrow="ALWAYS"/><Button text="Browse" minWidth="95" onAction="#browseDeviationDataset"/></HBox>
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Extended RDFS dataset:"/><Label fx:id="helpExtendedDataset" text="?" styleClass="help-badge"/></HBox><TextField fx:id="extendedDatasetTextField" editable="false" HBox.hgrow="ALWAYS"/><Button text="Browse" minWidth="95" onAction="#browseExtendedDataset"/></HBox>
          <Separator/>
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Result profile package:"/><Label fx:id="helpResultPackage" text="?" styleClass="help-badge"/></HBox><TextField fx:id="resultPackageTextField" promptText="Full URI or prefix:name, e.g. gb:Package_EQProfile" HBox.hgrow="ALWAYS"/></HBox>
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Result ontology:"/><Label fx:id="helpResultOntology" text="?" styleClass="help-badge"/></HBox><TextField fx:id="resultOntologyTextField" promptText="Full URI or prefix:name, e.g. gb:Ontology" HBox.hgrow="ALWAYS"/><Button text="Configure ontology…" onAction="#configureOntology"/></HBox>
          <HBox spacing="8"><HBox minWidth="180" spacing="6"><Label text="Deletion stereotype:"/><Label fx:id="helpDeletionStereotype" text="?" styleClass="help-badge"/></HBox><TextField fx:id="deletionStereotypeTextField" promptText="Optional; auto-detects a stereotype containing notDefined" HBox.hgrow="ALWAYS"/></HBox>
        </VBox>
        <HBox fx:id="simpleUnionOptions" spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"><CheckBox fx:id="keepOntologyHeadersCheckBox" text="Keep ontology headers" selected="true"/><Label fx:id="helpKeepOntologyHeaders" text="?" styleClass="help-badge"/></HBox>
        <HBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"><Label text="RDFS transformations:"/><Label fx:id="helpTransformations" text="?" styleClass="help-badge"/></HBox>
        <FlowPane hgap="16" vgap="8" prefWrapLength="1800" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"><CheckBox fx:id="inheritanceOnlyCheckBox" text="Process inheritance properties only" onAction="#updateInheritanceOptions"/><CheckBox fx:id="inheritanceListCheckBox" text="Generate inheritance list (Turtle)" disable="true" onAction="#updateInheritanceOptions"/><CheckBox fx:id="concreteOnlyCheckBox" text="Concrete classes only" disable="true"/><CheckBox fx:id="addOwlCheckBox" text="Add OWL types"/></FlowPane>
        <HBox spacing="6" GridPane.rowIndex="4" GridPane.columnIndex="0"><Label text="Target format:"/><Label fx:id="helpTargetFormat" text="?" styleClass="help-badge"/></HBox><ChoiceBox fx:id="targetFormatChoiceBox" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        <HBox spacing="6" GridPane.rowIndex="5" GridPane.columnIndex="0"><Label text="RDF/XML options:"/><Label fx:id="helpRdfXmlOptions" text="?" styleClass="help-badge"/></HBox><FlowPane hgap="16" vgap="8" prefWrapLength="1800" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="2"><CheckBox fx:id="showXmlDeclarationCheckBox" text="Show XML declaration" selected="true" disable="true"/><CheckBox fx:id="showDoctypeCheckBox" text="Show DOCTYPE declaration" disable="true"/><Label text="Tab:"/><TextField fx:id="tabTextField" text="2" prefWidth="50" disable="true"/><Label text="Relative URIs:"/><ChoiceBox fx:id="relativeUrisChoiceBox" prefWidth="160" disable="true"/><Label text="RDF format:"/><ChoiceBox fx:id="rdfXmlFormatChoiceBox" prefWidth="260" disable="true"/></FlowPane>
        <HBox spacing="6" GridPane.rowIndex="6" GridPane.columnIndex="0"><Label text="Base URI:"/><Label fx:id="helpBaseUri" text="?" styleClass="help-badge"/></HBox><HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="2"><ChoiceBox fx:id="baseUriChoiceBox" prefWidth="260"/><TextField fx:id="xmlBaseTextField" promptText="Leave empty to omit xml:base" HBox.hgrow="ALWAYS"/></HBox>
        <HBox spacing="6" GridPane.rowIndex="7" GridPane.columnIndex="0"><Label text="Sorting:"/><Label fx:id="helpSorting" text="?" styleClass="help-badge"/></HBox><FlowPane hgap="16" prefWrapLength="1800" GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.columnSpan="2"><CheckBox fx:id="sortCheckBox" text="Sort alphabetically" disable="true"/><ChoiceBox fx:id="sortOptionsChoiceBox" prefWidth="200" disable="true"/><CheckBox fx:id="stripPrefixesCheckBox" text="Strip unused prefixes" disable="true"/></FlowPane>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="action-bar"><Button text="Reset" minWidth="95" onAction="#reset"/><Button text="Save union result" minWidth="130" styleClass="primary-action" onAction="#saveUnionResult"/></HBox>
    </VBox>
  </ScrollPane>
</VBox>
