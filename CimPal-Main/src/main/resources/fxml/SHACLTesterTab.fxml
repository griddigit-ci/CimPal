<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.SHACLTesterController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox minHeight="0.0" minWidth="0.0" spacing="16.0" styleClass="tab-root">

        <GridPane hgap="8.0" vgap="8.0" styleClass="form-grid">
            <columnConstraints>
                <!-- 0: labels. Fixed so every row's field starts on the same x. -->
                <ColumnConstraints halignment="LEFT" hgrow="NEVER" minWidth="180.0" prefWidth="180.0" />
                <!-- 1: the field. The only column that absorbs slack. minWidth 0 lets the tab shrink. -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" />
                <!-- 2: Browse. Fixed so it never inflates into a banner. -->
                <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="95.0" prefWidth="95.0" />
            </columnConstraints>

            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="SHACL files:" wrapText="true"/>
                <Label fx:id="helpShaclFiles" text="?" styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="fPathShaclFilesValidator" editable="false" maxWidth="1.7976931348623157E308"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionBrowseShaclFilesTester" text="Browse"
                    GridPane.rowIndex="0" GridPane.columnIndex="2"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="Parent folder for test models:" wrapText="true"/>
                <Label fx:id="helpModelsFolder" text="?" styleClass="help-badge"/>
            </HBox>
            <TextField fx:id="fPathModelsForShaclValidator" editable="false" maxWidth="1.7976931348623157E308"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Button minWidth="95.0" mnemonicParsing="false" onAction="#actionBrowseFolderPathForShaclTester" text="Browse"
                    GridPane.rowIndex="1" GridPane.columnIndex="2"/>

            <!-- An option, not an action: it belongs with the inputs, not in the action bar. -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2">
                <CheckBox fx:id="cbExportReports" mnemonicParsing="false" selected="true"
                          text="Export model reports"/>
                <Label fx:id="helpExportReports" text="?" styleClass="help-badge"/>
            </HBox>
        </GridPane>

        <TreeView fx:id="treeViewShaclFiles" maxWidth="1.7976931348623157E308" minHeight="100.0"
                  showRoot="false" VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_RIGHT" spacing="8.0" styleClass="action-bar" VBox.vgrow="NEVER">
            <Button minWidth="95.0" mnemonicParsing="false"
                    onAction="#actionBtnResetShaclValidator" text="Reset"/>
            <Button minWidth="110.0" styleClass="primary-action" mnemonicParsing="false"
                    onAction="#actionBtnRunShaclValidator" text="Run"/>
        </HBox>
    </VBox>
  </ScrollPane>
</VBox>
