<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="eu.griddigit.cimpal.main.application.controllers.SHACLTesterController"
      minHeight="0.0" minWidth="0.0">
  <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="0.0" minWidth="0.0" VBox.vgrow="ALWAYS">
    <VBox minHeight="0.0" minWidth="0.0">
        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="SHACL files:" wrapText="true"/>
            <Label fx:id="helpShaclFiles" text="?" styleClass="help-badge"/>
            <TextField fx:id="fPathShaclFilesValidator" editable="false"
                       HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#actionBrowseShaclFilesTester"
                    text="Browse"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="5.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Parent folder for test models:" wrapText="true"/>
            <Label fx:id="helpModelsFolder" text="?" styleClass="help-badge"/>
            <TextField fx:id="fPathModelsForShaclValidator" editable="false"
                       HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#actionBrowseFolderPathForShaclTester"
                    text="Browse"/>
        </HBox>
        <HBox alignment="CENTER" minHeight="0.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <TreeView fx:id="treeViewShaclFiles" maxWidth="1.7976931348623157E308" minHeight="100.0"
                      showRoot="false" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox alignment="BOTTOM_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="10.0"
              VBox.vgrow="NEVER">
            <VBox.margin>
                <Insets/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Button minWidth="60.0" mnemonicParsing="false"
                    onAction="#actionBtnRunShaclValidator" text="Run"/>
            <Button minWidth="60.0" mnemonicParsing="false"
                    onAction="#actionBtnResetShaclValidator" text="Reset"/>
            <CheckBox fx:id="cbExportReports" mnemonicParsing="false" selected="true"
                      text="Export model reports"/>
            <Label fx:id="helpExportReports" text="?" styleClass="help-badge"/>
        </HBox>
    </VBox>
  </ScrollPane>
</VBox>
