{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(java -jar CimPal-CLI/target/CimPal-CLI.jar *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "PowerShell(mvn *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Bash(*New-ReleaseTag.ps1*)",
      "PowerShell(*New-ReleaseTag.ps1*)",
      "Bash(git push --tags*)",
      "Bash(git push --force*)",
      "PowerShell(git push --tags*)",
      "PowerShell(git push --force*)"
    ]
  }
}
