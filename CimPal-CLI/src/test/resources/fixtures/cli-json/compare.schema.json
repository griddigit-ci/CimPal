{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/griddigit-ci/CimPal/schemas/cimpal-compare-result/1",
  "$comment": "Copyright (c) 2020-2026 gridDigIt Kft. Licensed under the EUPL-1.2-or-later. SPDX-License-Identifier: EUPL-1.2+. The JSON document of compare --format json (and --summary-file) (TEST-4). Additive: new fields may appear in later versions; none are removed or renamed.",
  "title": "CimPal compare result",
  "type": "object",
  "required": ["schema", "fileA", "fileB", "compareType", "totalDifferences", "differences"],
  "properties": {
    "schema": {"const": "cimpal-compare-result/1"},
    "fileA": {"type": "string"},
    "fileB": {"type": "string"},
    "compareType": {"type": "string", "description": "The comparison that ran: rdfs, rdfs-cimtool or shacl (auto resolved from file A's extension)."},
    "totalDifferences": {"type": "integer", "minimum": 0},
    "differences": {"type": "array", "items": {"$ref": "#/$defs/difference"}},
    "stats": {"type": "object", "description": "With --stats; see stats.schema.json."}
  },
  "$defs": {
    "difference": {
      "type": "object",
      "required": ["item", "rdfType", "property", "valueA", "valueB"],
      "properties": {
        "item": {"type": ["string", "null"]},
        "rdfType": {"type": ["string", "null"]},
        "property": {"type": ["string", "null"]},
        "valueA": {"type": ["string", "null"]},
        "valueB": {"type": ["string", "null"]}
      }
    }
  }
}
