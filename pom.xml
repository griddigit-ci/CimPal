<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <properties>
        <jdk.version>25</jdk.version>
        <cimpal.version>2026.9.10.1</cimpal.version> <!-- Always sync with version tag -->
        <log4j.version>2.26.0</log4j.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jena.version>6.2.0</jena.version>
        <launch4j.version>2.7.0</launch4j.version>
        <javafx.version>25.0.3</javafx.version>
        <cyclonedx.plugin.version>2.9.1</cyclonedx.plugin.version>
        <dependency.check.plugin.version>12.1.0</dependency.check.plugin.version>
        <!-- Keep every PowSyBl module on one compatible release train. -->
        <powsybl.version>2026.1.0</powsybl.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <groupId>eu.griddigit.CimPal</groupId>
    <artifactId>CimPal</artifactId>
    <version>2026.9.10.1</version>
    <packaging>pom</packaging>
    <name>CimPal</name>
    <organization>
        <name>gridDigIt</name>
        <url>https://griddigit.eu/</url>
    </organization>
    <inceptionYear>2020</inceptionYear>
    <description>
        CimPal helps CIM implementation by providing tools facilitation the work related to SHACL constraints and identification of changes between different versions of CIM.
    </description>
    <licenses>
        <license>
            <name>European Union Public Licence 1.2 or later (EUPL-1.2-or-later)</name>
            <url>https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>CimPal-Core</module>
        <module>CimPal-Main</module>
        <module>CimPal-CustomWriter</module>
        <module>CimPal-CLI</module>
        <module>CimPal-Coverage</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- As in Core, CustomWriter and Main. 3.13.0 fails on Java 25 class files under
                     Maven 3.10 ("Unsupported class file major version 69"), which GitHub's Ubuntu
                     runner image ships since 2026-10. -->
                <version>3.14.1</version>
                <configuration>
                    <release>${jdk.version}</release>
                    <fork>true</fork>
                </configuration>
            </plugin>

            <!-- JaCoCo coverage for every module with tests (modules without tests have no execution
                 data and are skipped). The aggregate report is built by CimPal-Coverage; the
                 per-module ratchet is the coverage-ratchet profile below. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Software Bill of Materials, emitted for every build so that a dependency
                 advisory published after release can be correlated against what shipped. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Coverage ratchet. Active in every module that has a coverage-baseline.properties
          (written by scripts/Update-CoverageBaseline.ps1: measured line/branch ratio - 0.5 pp).
          `verify` fails when the module's coverage drops below those floors.

          The floors must not also be declared in <properties>: Maven would substitute the
          model value into the check's configuration before this file is read, and the
          check would silently use it instead.
        -->
        <profile>
            <id>coverage-ratchet</id>
            <activation>
                <file>
                    <exists>${basedir}/coverage-baseline.properties</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>properties-maven-plugin</artifactId>
                        <version>1.3.1</version>
                        <executions>
                            <execution>
                                <id>read-coverage-baseline</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>read-project-properties</goal>
                                </goals>
                                <configuration>
                                    <files>
                                        <file>${project.basedir}/coverage-baseline.properties</file>
                                    </files>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>coverage-ratchet</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${coverage.line.min}</minimum>
                                                </limit>
                                                <limit>
                                                    <counter>BRANCH</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${coverage.branch.min}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Dependency vulnerability scanning. Kept in an opt-in profile because the plugin
          downloads and updates a vulnerability database, which is too slow for a routine
          incremental build. Run it in CI and before a release:

              mvn -Psecurity-scan verify

          Fails the build on any dependency, declared or transitive, carrying an advisory
          with a CVSS score of 7.0 or above.
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency.check.plugin.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
