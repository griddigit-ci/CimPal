<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <properties>
        <jdk.version>25</jdk.version>
        <cimpal.version>2026.9.9.1</cimpal.version> <!-- Always sync with version tag -->
        <log4j.version>2.26.0</log4j.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jena.version>6.2.0</jena.version>
        <launch4j.version>2.7.0</launch4j.version>
        <javafx.version>25.0.3</javafx.version>
        <cyclonedx.plugin.version>2.9.1</cyclonedx.plugin.version>
        <dependency.check.plugin.version>12.1.0</dependency.check.plugin.version>
    </properties>

    <groupId>eu.griddigit.CimPal</groupId>
    <artifactId>CimPal</artifactId>
    <version>2026.9.9.1</version>
    <packaging>pom</packaging>
    <name>CimPal</name>
    <organization>
        <name>gridDigIt</name>
        <url>https://griddigit.eu/</url>
    </organization>
    <inceptionYear>2020</inceptionYear>
    <description>
        CimPal helps CIM implementation by providing tools facilitation the work related to SHACL constraints and identification of changes between different versions of CIM.
    </description>

    <modules>
        <module>CimPal-Core</module>
        <module>CimPal-Main</module>
        <module>CimPal-CustomWriter</module>
        <module>CimPal-CLI</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${jdk.version}</release>
                    <fork>true</fork>
                </configuration>
            </plugin>

            <!-- Software Bill of Materials, emitted for every build so that a dependency
                 advisory published after release can be correlated against what shipped. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Dependency vulnerability scanning. Kept in an opt-in profile because the plugin
          downloads and updates a vulnerability database, which is too slow for a routine
          incremental build. Run it in CI and before a release:

              mvn -Psecurity-scan verify

          Fails the build on any dependency, declared or transitive, carrying an advisory
          with a CVSS score of 7.0 or above.
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency.check.plugin.version}</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>