PREFIX cim:  <http://iec.ch/TC57/CIM100#>
PREFIX ex:   <http://example.com/constraints#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

ex:Terminal.phases-in
        a         sh:PropertyShape;
        sh:group  ex:Values;
        sh:in     ( cim:PhaseCode.A cim:PhaseCode.ABC );
        sh:in     ( cim:PhaseCode.ABC );
        sh:name   "Terminal.phases-in";
        sh:path   cim:Terminal.phases .

ex:Terminal  a          sh:NodeShape;
        sh:property     ex:Terminal.phases-in;
        sh:targetClass  cim:Terminal .

ex:Values  a        sh:PropertyGroup;
        rdfs:label  "Values";
        sh:order    1 .
