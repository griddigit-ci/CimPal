PREFIX cim:     <http://iec.ch/TC57/CIM100#>
PREFIX cims:    <http://iec.ch/TC57/1999/rdf-schema-extensions-19990926#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX meq:     <http://example.com/ns/MiniEquipment-EU#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

cim:Terminal.phases  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:Terminal;
        rdfs:label         "phases"@en;
        rdfs:range         cim:PhaseCode;
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:ACLineSegment  rdf:type     owl:Class , rdfs:Class;
        rdfs:label              "ACLineSegment"@en;
        rdfs:subClassOf         cim:ConductingEquipment;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         <http://iec.ch/TC57/NonStandard/UML#concrete> .

cim:Float  rdf:type             owl:DatatypeProperty , owl:Class , rdfs:Class;
        rdfs:label              "Float"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         "Primitive" .

cim:PhaseCode.A  rdf:type  owl:NamedIndividual , cim:PhaseCode;
        rdfs:label       "A"@en;
        cims:stereotype  "enum" .

cim:Equipment  rdf:type         owl:Class , rdfs:Class;
        rdfs:label              "Equipment"@en;
        rdfs:subClassOf         cim:IdentifiedObject;
        cims:belongsToCategory  meq:Package_MiniEquipment .

meq:Ontology  rdf:type   owl:Ontology;
        dcterms:title    "Mini Equipment Vocabulary"@en;
        owl:versionIRI   <http://example.com/ns/MiniEquipment-EU/3.0>;
        owl:versionInfo  "3.0.0"@en .

meq:Package_MiniEquipment
        rdf:type    cims:ClassCategory;
        rdfs:label  "MiniEquipment"@en .

cim:Resistance  rdf:type        owl:DatatypeProperty , owl:Class , rdfs:Class;
        rdfs:label              "Resistance"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         "CIMDatatype" .

cim:Terminal.ConductingEquipment
        rdf:type              owl:ObjectProperty , rdf:Property;
        rdfs:domain           cim:Terminal;
        rdfs:label            "ConductingEquipment"@en;
        rdfs:range            cim:ConductingEquipment;
        cims:AssociationUsed  "Yes";
        cims:inverseRoleName  cim:ConductingEquipment.Terminals;
        cims:multiplicity     cims:M:1 .

cim:IdentifiedObject.mRID
        rdf:type           owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:IdentifiedObject;
        rdfs:label         "mRID"@en;
        cims:dataType      cim:String;
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:Resistance.multiplier
        rdf:type           owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:Resistance;
        rdfs:label         "multiplier"@en;
        rdfs:range         cim:UnitMultiplier;
        cims:isFixed       "none";
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:ConductingEquipment
        rdf:type                owl:Class , rdfs:Class;
        rdfs:label              "ConductingEquipment"@en;
        rdfs:subClassOf         cim:Equipment;
        cims:belongsToCategory  meq:Package_MiniEquipment .

cim:Resistance.value  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:Resistance;
        rdfs:label         "value"@en;
        cims:dataType      cim:Float;
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:ACLineSegment.r  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:ACLineSegment;
        rdfs:label         "r"@en;
        cims:dataType      cim:Resistance;
        cims:multiplicity  cims:M:1..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:Boolean  rdf:type           owl:DatatypeProperty , owl:Class , rdfs:Class;
        rdfs:label              "Boolean"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         "Primitive" .

cim:String  rdf:type            owl:DatatypeProperty , owl:Class , rdfs:Class;
        rdfs:label              "String"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         "Primitive" .

cim:IdentifiedObject  rdf:type  owl:Class , rdfs:Class;
        rdfs:label              "IdentifiedObject"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment .

cim:UnitMultiplier  rdf:type    owl:Class , rdfs:Class;
        rdfs:label              "UnitMultiplier"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         <http://iec.ch/TC57/NonStandard/UML#enumeration> .

cim:Equipment.aggregate
        rdf:type           owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:Equipment;
        rdfs:label         "aggregate"@en;
        cims:dataType      cim:Boolean;
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:PhaseCode.ABC  rdf:type  owl:NamedIndividual , cim:PhaseCode;
        rdfs:label       "ABC"@en;
        cims:stereotype  "enum" .

cim:PhaseCode  rdf:type         owl:Class , rdfs:Class;
        rdfs:label              "PhaseCode"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         <http://iec.ch/TC57/NonStandard/UML#enumeration> .

cim:UnitSymbol  rdf:type        owl:Class , rdfs:Class;
        rdfs:label              "UnitSymbol"@en;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         <http://iec.ch/TC57/NonStandard/UML#enumeration> .

cim:UnitMultiplier.none
        rdf:type         owl:NamedIndividual , cim:UnitMultiplier;
        rdfs:label       "none"@en;
        cims:stereotype  "enum" .

cim:Terminal  rdf:type          owl:Class , rdfs:Class;
        rdfs:label              "Terminal"@en;
        rdfs:subClassOf         cim:IdentifiedObject;
        cims:belongsToCategory  meq:Package_MiniEquipment;
        cims:stereotype         <http://iec.ch/TC57/NonStandard/UML#concrete> .

cim:UnitSymbol.ohm  rdf:type  owl:NamedIndividual , cim:UnitSymbol;
        rdfs:label       "ohm"@en;
        cims:stereotype  "enum" .

cim:ConductingEquipment.Terminals
        rdf:type              owl:ObjectProperty , rdf:Property;
        rdfs:domain           cim:ConductingEquipment;
        rdfs:label            "Terminals"@en;
        rdfs:range            cim:Terminal;
        cims:AssociationUsed  "No";
        cims:inverseRoleName  cim:Terminal.ConductingEquipment;
        cims:multiplicity     cims:M:0..n .

cim:Resistance.unit  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:Resistance;
        rdfs:label         "unit"@en;
        rdfs:range         cim:UnitSymbol;
        cims:isFixed       "ohm";
        cims:multiplicity  cims:M:0..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .

cim:IdentifiedObject.name
        rdf:type           owl:ObjectProperty , rdf:Property;
        rdfs:domain        cim:IdentifiedObject;
        rdfs:label         "name"@en;
        cims:dataType      cim:String;
        cims:multiplicity  cims:M:1..1;
        cims:stereotype    <http://iec.ch/TC57/NonStandard/UML#attribute> .
